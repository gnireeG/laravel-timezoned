{
    "name": "gnireeg/laravel-timezoned",
    "version": "1.0.0",
    "description": "A lightweight Laravel package that provides a trait to automatically convert all date attributes of an Eloquent model from the database timezone to the user's timezone - and convert incoming user-provided dates back to the database timezone as well.",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Gnireeg\\LaravelTimezoned\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Joel Geering",
            "email": "joel@geering.dev"
        }
    ],
    "require": {
        "php": ">=8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0",
        "nesbot/carbon": "^2.0 || ^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0 || ^9.0 || ^10.0",
        "phpunit/phpunit": "^10.0 || ^11.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Gnireeg\\LaravelTimezoned\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gnireeg\\LaravelTimezoned\\LaravelTimezonedServiceProvider"
            ]
        }
    }
}
